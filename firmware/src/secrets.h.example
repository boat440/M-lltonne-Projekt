// echten Werte ein. "secrets.h" wird per .gitignore NICHT eingecheckt, damit
// dein WLAN-Passwort nicht im (öffentlichen!) GitHub-Repo landet.

#define WIFI_SSID "DEIN_WLAN_NAME"
#define WIFI_PASSWORD "DEIN_WLAN_PASSWORT"

